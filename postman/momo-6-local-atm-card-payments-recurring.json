e245ad-01ff-4718-b087-0b6dbb95415c"}},{"listen":"test","script":{"exec":["let response = pm.response.json();\r","let callbackToken = response.callbackToken;\r","if(callbackToken)   pm.environment.set(\"callbackToken\", callbackToken);"],"type":"text/javascript","id":"5a5c5ece-5702-46ca-9a48-1100a02acc57"}}],"id":"699d9134-eb3f-4c70-9628-d25394e79201","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"partnerClientId\": \"{{partnerClientId}}\",\n    \"lang\": \"{{lang}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/tokenization/cbQuery"},"response":[]},{"name":"Delete token - Xóa token","event":[{"listen":"prerequest","script":{"exec":["let time = new Date().getTime();","","let requestId = \"RE\" + time;","let orderId = \"OD\" + time;","","// let partnerClientId = \"1663344105307_cuong.mai1@mservice.com.vn\";","let partnerClientId = pm.environment.get(\"partnerClientId\");","","let tokenDecrypted = Utils.decryptAES(pm.environment.get(\"aesToken\"), pm.environment.get(\"secretKey\"));","tokenDecrypted = JSON.parse(tokenDecrypted);","console.log(\"tokenDecrypted\", tokenDecrypted)","","let tokenJson = JSON.stringify(tokenDecrypted);","console.log(\"tokenJson\", tokenJson);","let paymentToken = Utils.encryptRSA(tokenJson, pm.environment.get(\"publicKey\"));","console.log(\"paymentToken\", paymentToken);","","let token = paymentToken;","// let token = pm.environment.get(\"token\");","// let token = \"\";","","pm.environment.set('requestId', requestId);","pm.environment.set('orderId', orderId);","pm.environment.set('partnerClientId', partnerClientId);","pm.environment.set('token', token);","","let includeInSignature = ['accessKey','orderId', 'partnerClientId', 'partnerCode',  'requestId', 'token'];","","pm.environment.set('signature', Utils.buildSignature(includeInSignature, pm));"],"type":"text/javascript","id":"b97ede0f-dfd1-432e-a629-3b3a6b32c0e7"}}],"id":"0ee0a74a-da39-4d3f-af4e-15511346c04f","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"token\":\"{{token}}\",\n    \"partnerClientId\": \"{{partnerClientId}}\",\n    \"lang\": \"{{lang}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/tokenization/delete"},"response":[]}],"event":[{"listen":"prerequest","script":{"id":"cff8bb37-d004-4415-8a34-145c344b96ab","type":"text/javascript","exec":["Utils = {","    // fields is arrays of field need to build signature","    // postman is current postman variable","    buildSignature: function(fields, postman) {","        fields = fields.sort((a, b) => a.localeCompare(b)); // sort signature theo alphabet","        let signature = '';","        for (let i = 0; i < fields.length; i++) {","            let key = fields[i];","            let value = postman.environment.get(key); // get from current enviroment","            if (value == null || value == undefined) value = postman.globals.get(key); // if value current environment undefined, get from global variable","            if (i !== 0) signature += '&';","            signature = signature + key + '=';","            if (value != null && value != undefined && value.toString().trim() !== '') signature += value.toString();","        }","        console.log('Raw signature before hash: ', signature);","        let hash = CryptoJS.HmacSHA256(signature, postman.environment.get(\"secretKey\"));","        signature = CryptoJS.enc.Hex.stringify(hash);","        // postman.environment.set('signature', signature);","","        return signature;","    },","    decryptAES: function(data, secretKey) {","        let rawData = CryptoJS.enc.Base64.parse(data);","        let key = CryptoJS.enc.Latin1.parse(secretKey);","        let iv = CryptoJS.enc.Latin1.parse(\"\");","        let plaintextData = CryptoJS.AES.decrypt({","                ciphertext: rawData","            },","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString(CryptoJS.enc.Latin1);","    },","    encryptAES: function(data, secretKey) {","        let key = CryptoJS.enc.Utf8.parse(secretKey);","        let iv = CryptoJS.enc.Utf8.parse(\"\");","        let plaintextData = CryptoJS.AES.encrypt(","            data,","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString();","    },","    encryptRSA: function(data, publicKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPublicKey(publicKey);","","        return jsencrypt.encrypt(data);","    },","    decryptRSA: function(data, privateKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPrivateKey(privateKey);","","        return jsencrypt.decrypt(data);","    }","}"]}},{"listen":"test","script":{"id":"4b0f3c00-0e22-4721-81cd-13a4c7a65d44","type":"text/javascript","exec":[""]}}]}