et partnerClientId = pm.environment.get(\"partnerClientId\");","","// token is same as with token in step 3, to avoid rebuilding it, we get it from environment","let token = pm.environment.get(\"token\");","// let token = \"\";","","pm.environment.set('requestId', requestId);","pm.environment.set('orderId', orderId);","pm.environment.set('partnerClientId', partnerClientId);","pm.environment.set('token', token);","","let includeInSignature = ['accessKey','orderId', 'partnerClientId', 'partnerCode',  'requestId', 'token'];","","pm.environment.set('signature', Utils.buildSignature(includeInSignature, pm));"],"type":"text/javascript"}}],"id":"04192962-89b8-4f0d-ba68-6a73fb8af1b9","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"token\":\"{{token}}\",\n    \"partnerClientId\": \"{{partnerClientId}}\",\n    \"lang\": \"{{lang}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/tokenization/delete"},"response":[{"id":"5b1c3036-edef-49fc-82c0-98e192c0ef4b","name":"200","originalRequest":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"token\":\"{{token}}\",\n    \"partnerClientId\": \"{{partnerClientId}}\",\n    \"lang\": \"{{lang}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/tokenization/delete"},"status":"OK","code":200,"_postman_previewlanguage":"json","header":[{"key":"Server","value":"nginx"},{"key":"Date","value":"Mon, 29 Jul 2024 07:09:23 GMT"},{"key":"Content-Type","value":"application/json"},{"key":"Transfer-Encoding","value":"chunked"},{"key":"Connection","value":"keep-alive"},{"key":"Vary","value":"Accept-Encoding"},{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-XSS-Protection","value":"1; mode=block"},{"key":"Pragma","value":"no-cache"},{"key":"Strict-Transport-Security","value":"max-age=15768000"},{"key":"Content-Encoding","value":"gzip"}],"cookie":[],"responseTime":null,"body":"{\n    \"partnerCode\": \"MOMOV3FN20220908\",\n    \"orderId\": \"OD1722236963328\",\n    \"requestId\": \"RE1722236963328\",\n    \"responseTime\": 1722236963706,\n    \"message\": \"Thành công.\",\n    \"resultCode\": 0,\n    \"partnerClientId\": \"1722235998071_cuong.mai1@mservice.com.vn\",\n    \"transId\": 4090770401\n}"}]}],"event":[{"listen":"prerequest","script":{"id":"8240f637-3ca0-4be4-87e9-383c1a050968","type":"text/javascript","exec":["Utils = {","    // fields is arrays of field need to build signature","    // postman is current postman variable","    buildSignature: function(fields, postman) {","        fields = fields.sort((a, b) => a.localeCompare(b)); // sort signature theo alphabet","        let signature = '';","        for (let i = 0; i < fields.length; i++) {","            let key = fields[i];","            let value = postman.environment.get(key); // get from current enviroment","            if (value == null || value == undefined) value = postman.globals.get(key); // if value current environment undefined, get from global variable","            if (i !== 0) signature += '&';","            signature = signature + key + '=';","            if (value != null && value != undefined && value.toString().trim() !== '') signature += value.toString();","        }","        console.log('Raw signature before hash: ', signature);","        let hash = CryptoJS.HmacSHA256(signature, postman.environment.get(\"secretKey\"));","        signature = CryptoJS.enc.Hex.stringify(hash);","        // postman.environment.set('signature', signature);","","        return signature;","    },","    decryptAES: function(data, secretKey) {","        let rawData = CryptoJS.enc.Base64.parse(data);","        let key = CryptoJS.enc.Latin1.parse(secretKey);","        let iv = CryptoJS.enc.Latin1.parse(\"\");","        let plaintextData = CryptoJS.AES.decrypt({","                ciphertext: rawData","            },","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString(CryptoJS.enc.Latin1);","    },","    encryptAES: function(data, secretKey) {","        let key = CryptoJS.enc.Utf8.parse(secretKey);","        let iv = CryptoJS.enc.Utf8.parse(\"\");","        let plaintextData = CryptoJS.AES.encrypt(","            data,","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString();","    },","    encryptRSA: function(data, publicKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPublicKey(publicKey);","","        return jsencrypt.encrypt(data);","    },","    decryptRSA: function(data, privateKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPrivateKey(privateKey);","","        return jsencrypt.decrypt(data);","    }","}"]}},{"listen":"test","script":{"id":"fa23e7c0-30cf-4613-b019-aea073dcf8dc","type":"text/javascript","exec":[""]}}]}