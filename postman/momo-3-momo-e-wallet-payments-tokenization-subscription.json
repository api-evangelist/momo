ble","    buildSignature: function(fields, postman) {","        fields = fields.sort((a, b) => a.localeCompare(b)); // sort signature theo alphabet","        let signature = '';","        for (let i = 0; i < fields.length; i++) {","            let key = fields[i];","            let value = postman.environment.get(key); // get from current enviroment","            if (value == null || value == undefined) value = postman.globals.get(key); // if value current environment undefined, get from global variable","            if (i !== 0) signature += '&';","            signature = signature + key + '=';","            if (value != null && value != undefined && value.toString().trim() !== '') signature += value.toString();","        }","        console.log('Raw signature before hash: ', signature);","        let hash = CryptoJS.HmacSHA256(signature, postman.environment.get(\"secretKey\"));","        signature = CryptoJS.enc.Hex.stringify(hash);","        // postman.environment.set('signature', signature);","","        return signature;","    },","    decryptAES: function(data, secretKey) {","        let rawData = CryptoJS.enc.Base64.parse(data);","        let key = CryptoJS.enc.Latin1.parse(secretKey);","        let iv = CryptoJS.enc.Latin1.parse(\"\");","        let plaintextData = CryptoJS.AES.decrypt({","                ciphertext: rawData","            },","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString(CryptoJS.enc.Latin1);","    },","    encryptAES: function(data, secretKey) {","        let key = CryptoJS.enc.Utf8.parse(secretKey);","        let iv = CryptoJS.enc.Utf8.parse(\"\");","        let plaintextData = CryptoJS.AES.encrypt(","            data,","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString();","    },","    encryptRSA: function(data, publicKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPublicKey(publicKey);","","        return jsencrypt.encrypt(data);","    },","    decryptRSA: function(data, privateKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPrivateKey(privateKey);","","        return jsencrypt.decrypt(data);","    }","}"]}},{"listen":"test","script":{"id":"33a2dacc-3193-41e1-97c2-b4edea759abc","type":"text/javascript","exec":[""]}}]}