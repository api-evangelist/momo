ew Date().getTime();","","let requestId = \"RE\" + time;","","// orderId of refund != orderId when create, orderId here must be new","let orderId = \"OD\" + time;","","// id of payment transaction, you  received it in confirm or query step","let transId = \"60318823606\";","// let transId = pm.environment.get(\"transId\");","","let description = `Hoàn tiền cho giao dịch ${transId}`;","let amount = 1000;","","pm.environment.set('requestId', requestId);","pm.environment.set('orderId', orderId);","pm.environment.set('transId', transId);","pm.environment.set('description', description);","pm.environment.set('amount', amount);","","let includeInSignature = ['accessKey', 'amount', 'description', 'orderId', 'partnerCode', 'requestId', 'transId'];","","pm.environment.set('signature', Utils.buildSignature(includeInSignature, pm));"],"type":"text/javascript"}},{"listen":"test","script":{"id":"e6509e99-952d-4238-b30b-3a3f21c9223b","exec":["let response = pm.response.json();","let orderId = response[\"orderId\"];","let requestId = response[\"requestId\"];","// let transId = response[\"transId\"];","","if(orderId)     pm.environment.set('orderId', orderId);","if(requestId)   pm.environment.set('requestId', requestId);","// if(transId)     pm.environment.set('transId', transId);"],"type":"text/javascript"}}],"id":"c6ebbfe9-5f3d-434b-8050-6cd56d9bb0a1","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"amount\": \"{{amount}}\",\n    \"transId\": \"{{transId}}\",\n    \"lang\": \"{{lang}}\",\n    \"description\": \"{{description}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/refund"},"response":[{"id":"e756acd8-f263-401d-a384-beb106a4b04e","name":"200","originalRequest":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"amount\": \"{{amount}}\",\n    \"transId\": \"{{transId}}\",\n    \"lang\": \"{{lang}}\",\n    \"description\": \"{{description}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/refund"},"status":"OK","code":200,"_postman_previewlanguage":"json","header":[{"key":"Server","value":"nginx"},{"key":"Date","value":"Fri, 16 Sep 2022 15:16:36 GMT"},{"key":"Content-Type","value":"application/json"},{"key":"Transfer-Encoding","value":"chunked"},{"key":"Connection","value":"keep-alive"},{"key":"Vary","value":"Accept-Encoding"},{"key":"x-content-type-options","value":"nosniff"},{"key":"x-xss-protection","value":"1; mode=block"},{"key":"pragma","value":"no-cache"},{"key":"X-Kong-Upstream-Latency","value":"1007"},{"key":"X-Kong-Proxy-Latency","value":"0"},{"key":"Via","value":"kong/0.14.1"},{"key":"Strict-Transport-Security","value":"max-age=15768000"},{"key":"Content-Encoding","value":"gzip"}],"cookie":[],"responseTime":null,"body":"{\n    \"partnerCode\": \"MOMOBKUN20180529\",\n    \"orderId\": \"OD1663341395713\",\n    \"requestId\": \"RE1663341395713\",\n    \"amount\": 10000,\n    \"transId\": 2727604374,\n    \"resultCode\": 0,\n    \"message\": \"Giao dịch thành công.\",\n    \"responseTime\": 1663341396881\n}"}]}],"event":[{"listen":"prerequest","script":{"id":"a8986902-7e60-4886-be80-c4b8ada3c58f","type":"text/javascript","exec":["Utils = {","    // fields is arrays of field need to build signature","    // postman is current postman variable","    buildSignature: function(fields, postman) {","        fields = fields.sort((a, b) => a.localeCompare(b)); // sort signature theo alphabet","        let signature = '';","        for (let i = 0; i < fields.length; i++) {","            let key = fields[i];","            let value = postman.environment.get(key); // get from current enviroment","            if (value == null || value == undefined) value = postman.globals.get(key); // if value current environment undefined, get from global variable","            if (i !== 0) signature += '&';","            signature = signature + key + '=';","            if (value != null && value != undefined && value.toString().trim() !== '') signature += value.toString();","        }","        console.log('Raw signature before hash: ', signature);","        let hash = CryptoJS.HmacSHA256(signature, postman.environment.get(\"secretKey\"));","        signature = CryptoJS.enc.Hex.stringify(hash);","        // postman.environment.set('signature', signature);","","        return signature;","    },","    decryptAES: function(data, secretKey) {","        let rawData = CryptoJS.enc.Base64.parse(data);","        let key = CryptoJS.enc.Latin1.parse(secretKey);","        let iv = CryptoJS.enc.Latin1.parse(\"\");","        let plaintextData = CryptoJS.AES.decrypt({","                ciphertext: rawData","            },","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString(CryptoJS.enc.Latin1);","    },","    encryptAES: function(data, secretKey) {","        let key = CryptoJS.enc.Utf8.parse(secretKey);","        let iv = CryptoJS.enc.Utf8.parse(\"\");","        let plaintextData = CryptoJS.AES.encrypt(","            data,","            key, {","                iv: iv","            }","        );","","        return plaintextData.toString();","    },","    encryptRSA: function(data, publicKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPublicKey(publicKey);","","        return jsencrypt.encrypt(data);","    },","    decryptRSA: function(data, privateKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPrivateKey(privateKey);","","        return jsencrypt.decrypt(data);","    }","}"]}},{"listen":"test","script":{"id":"b0fe4f25-e100-40cf-b420-a2fcd89577cc","type":"text/javascript","exec":[""]}}]}