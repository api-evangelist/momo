,"// let orderId = pm.environment.get(\"orderId\");","let orderId =\"OD\" + time;","console.log(orderId);","","// gen disbursement method","let disbursementMethod2Encrypt = {","    \"walletId\": \"0367597481\"","}","disbursementMethod2Encrypt = JSON.stringify(disbursementMethod2Encrypt);","console.log(\"disbursementMethod before encryt\", disbursementMethod2Encrypt)","let disbursementMethod = Utils.encryptRSA(disbursementMethod2Encrypt, pm.environment.get(\"publicKey\"));","console.log(\"disbursementMethod after encrypt\", disbursementMethod)","// let disbursementMethod = pm.environment.get(\"disbursementMethod\");","// let disbursementMethod = \"\";","pm.environment.set(\"disbursementMethod\", disbursementMethod);","let requestType = \"checkWallet\";","// let requestType = \"disburseToBank\";","let extraData = \"\";","","pm.environment.set(\"requestId\", requestId);","pm.environment.set(\"orderId\",orderId);","pm.environment.set(\"disbursementMethod\",disbursementMethod);","pm.environment.set(\"requestType\",requestType);","","let includeInSignature = ['accessKey','disbursementMethod', 'orderId', 'partnerCode',  'requestId', 'requestType'];","","pm.environment.set('signature', Utils.buildSignature(includeInSignature, pm));"],"type":"text/javascript","id":"42b805f8-5a0c-40e3-99ec-ebcbfb3f92f5"}}],"id":"d287f6ed-80fe-4c93-bf9b-bcb5f47d7736","protocolProfileBehavior":{"disabledSystemHeaders":{},"disableBodyPruning":true},"request":{"method":"POST","header":[{"key":"Content-Type","value":"multipart/form-data","type":"text","disabled":true}],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"requestType\": \"{{requestType}}\",\n    \"lang\": \"{{lang}}\",\n    \"disbursementMethod\": \"{{disbursementMethod}}\",\n    \"requestId\": \"{{requestId}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/disbursement/verify"},"response":[]},{"name":"Get Balanace","event":[{"listen":"prerequest","script":{"exec":["var date = new Date().getTime();","console.log(date);","var requestId = date+\"id\";","var orderId = 'OD' + date;","var extraData = \"ew0KImVtYWlsIjogImh1b25neGRAZ21haWwuY29tIg0KfQ==\";","var signature = \"accessKey=\"+pm.environment.get(\"accessKey\") +\"&orderId=\" + orderId + \"&partnerCode=\" + pm.environment.get(\"partnerCode\") +\"&requestId=\" + requestId;","console.log(signature);","var hash = CryptoJS.HmacSHA256(signature, pm.environment.get(\"secretKey\"));","signature = CryptoJS.enc.Hex.stringify(hash);","postman.setEnvironmentVariable(\"signature\",signature);","postman.setEnvironmentVariable(\"requestId\", requestId);","postman.setEnvironmentVariable(\"orderId\",orderId);","postman.setEnvironmentVariable(\"extraData\",extraData);","postman.setEnvironmentVariable(\"lang\", 'en');",""],"type":"text/javascript","id":"849acb99-220f-454e-9e21-3f19bc3875b0"}}],"id":"d709fb34-79cf-4da2-bb35-bb67d9b4081b","protocolProfileBehavior":{"disableBodyPruning":true},"request":{"method":"POST","header":[],"body":{"mode":"raw","raw":"{\n    \"partnerCode\": \"{{partnerCode}}\",\n    \"orderId\": \"{{orderId}}\",\n    \"lang\": \"{{lang}}\",\n    \"orderGroupId\": 5706,\n    \"requestId\": \"{{requestId}}\",\n    \"signature\": \"{{signature}}\"\n}","options":{"raw":{"language":"json"}}},"url":"{{paygate}}/v2/gateway/api/disbursement/balance"},"response":[]}],"event":[{"listen":"prerequest","script":{"type":"text/javascript","exec":["Utils = {","    buildSignature: function(fields, postman) {","        fields = fields.sort((a, b) => a.localeCompare(b)); // sort signature theo alphabet","        let signature = '';","        for (let i = 0; i < fields.length; i++) {","            let key = fields[i];","            let value = postman.environment.get(key);","            if (value == null || value == undefined) value = postman.globals.get(key);","            if (i !== 0) signature += '&';","            signature = signature + key + '=';","            if (value != null && value != undefined && value.toString().trim() !== '') signature += value.toString();","        }","        console.log('raw signature ', signature);","        let hash = CryptoJS.HmacSHA256(signature, postman.environment.get(\"secretKey\"));","        signature = CryptoJS.enc.Hex.stringify(hash);","        // postman.environment.set('signature', signature);","","        return signature;","    },","    encryptRSA: function(data, publicKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPublicKey(publicKey);","","        return jsencrypt.encrypt(data);","    },","    decryptRSA: function(data, privateKey) {","        window = {};","        let jsEnvName = \"jsencrypt.bundle\";","        let jsScript = pm.environment.get(jsEnvName);","        if (jsScript == null || jsScript == undefined) jsScript = pm.globals.get(jsEnvName);","        eval(jsScript);","        let jsencrypt = new JSEncrypt({","            default_key_size: 2048","        });","        jsencrypt.setPrivateKey(privateKey);","","        return jsencrypt.decrypt(data);","    }","}"],"id":"60be6bfb-8997-4c32-8bb4-d539b3dc3a00"}},{"listen":"test","script":{"type":"text/javascript","exec":[""],"id":"94350e36-bb21-4313-bc19-ca3048fd8b32"}}]}